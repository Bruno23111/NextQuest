{
  "registerRequest": { "email": "jogadora@example.org", "password": "senha-de-exemplo" },
  "loginResponse": {
    "tokenType": "Bearer",
    "accessToken": "token-opaco-de-exemplo",
    "expiresIn": 900,
    "refreshToken": "token-de-renovacao-de-exemplo"
  },
  "refreshRequest": { "refreshToken": "token-de-renovacao-de-exemplo" },
  "resetRequest": {
    "email": "jogadora@example.org",
    "resetCode": "codigo-do-email",
    "newPassword": "outra-senha-de-exemplo"
  },
  "unauthorized": {
    "title": "Credenciais inválidas ou conta indisponível.",
    "status": 401,
    "traceId": "exemplo-auth"
  }
}
