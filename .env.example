# Copie para .env.development.local. Preencha os valores sem aspas.
# Catálogo
Rawg__ApiKey=

# IDs das contas autorizadas, separados por vírgula.
Admin__UserIds=

# Promoções
IsThereAnyDeal__ApiKey=

# Biblioteca e conquistas da Steam. O login Steam usa OpenID e dispensa esta chave.
Steam__ApiKey=

# Vinculação de conta Discord. Cadastre esta mesma URL no aplicativo OAuth2.
Discord__ClientId=
Discord__ClientSecret=
Discord__RedirectUri=http://localhost:4201/profile
