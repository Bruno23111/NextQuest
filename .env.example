# Copie para .env.development.local. Preencha os valores sem aspas.
# Catálogo
Rawg__ApiKey=

# IDs das contas autorizadas, separados por vírgula.
Admin__UserIds=

# Promoções
IsThereAnyDeal__ApiKey=

# Busca e publicação de vídeos na administração.
YouTube__ApiKey=

# Biblioteca e conquistas da Steam. O login Steam usa OpenID e dispensa esta chave.
Steam__ApiKey=

# Vinculação de conta Discord. Cadastre esta mesma URL no aplicativo OAuth2.
Discord__ClientId=
Discord__ClientSecret=
Discord__RedirectUri=http://localhost:4201/profile

# Opcional: preencha com valores fornecidos para um cliente OAuth autorizado pela Sony.
PsnOAuth__AuthorizationUrl=
PsnOAuth__TokenUrl=
PsnOAuth__ClientId=
PsnOAuth__ClientSecret=
PsnOAuth__Scope=
PsnOAuth__RedirectUri=
PsnOAuth__WebReturnUrl=
